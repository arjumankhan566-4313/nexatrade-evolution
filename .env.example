# Copy to .env and fill in real values. NEVER commit the real .env file.

# ── Supabase (Lovable Cloud) ────────────────────────────────────────────────
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# ── Frontend → backend API origin (used by sockets + the /api proxy) ────────
VITE_API_URL="http://localhost:4000"
# Server-side override for the /api/* and /socket.io/* forwarders (production:
# the real backend origin, e.g. https://api.example.com)
BACKEND_URL="http://localhost:4000"