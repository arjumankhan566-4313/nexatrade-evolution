# ── NexaTrade V2 client (Vite) ──────────────────────────────────────────────
# Only VITE_-prefixed variables reach the browser bundle.
# NEVER put secrets (JWT_SECRET, DATABASE_URL, API keys) here — those live in
# the server environment only.

# Public site URL (SEO) — migrated from legacy NEXT_PUBLIC_SITE_URL
VITE_SITE_URL=

# Google Analytics 4 measurement id (G-XXXXXXXXXX) — from NEXT_PUBLIC_GA_ID
VITE_GA_ID=

# API base URL. Empty = same origin: the Vite dev server proxies /api and
# /socket.io to the API. Set only when the API is deployed on another origin.
VITE_API_URL=

# Dev-only: proxy target used by the Vite dev server.
VITE_PROXY_TARGET=http://localhost:4000
