# Base44 development defaults — NOT secrets.
#
# These placeholders let the stack boot in the sandbox with no credentials at
# all. Every service lists this file FIRST and /run/base44/app.env LAST, so a
# real value supplied in the dashboard always overrides what is here.
#
# v2-api is database-backed (users, trades, the OTC catalogue and its candles).
# The sandbox runs a plain Postgres (`v2-postgres` in docker-compose.base44.yml)
# so the preview works offline. Set DATABASE_URL in the dashboard Secrets page
# to point the app at the real Neon/Supabase database instead — it will win.
#
# `sslmode=disable` is required: the local server speaks no TLS, and both the
# legacy db client and the V2 pool enable TLS for any non-localhost host.
DATABASE_URL=postgres://nexa:nexa_dev_pw@v2-postgres:5432/nexatrade?sslmode=disable
