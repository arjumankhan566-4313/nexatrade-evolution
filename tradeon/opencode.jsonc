{
  "$schema": "https://opencode.ai/config.json",

  "model": "atria/Atria-Dawn-Preview",

  "provider": {
    "atria": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Atria",

      "options": {
        "baseURL": "https://api.atria-asi.ai/v1"
      },

      "models": {
        "Atria-Dawn-Preview": {
          "name": "Atria-Dawn",

          "limit": {
            "context": 256000,
            "output": 65536
          },

          "variants": {
            "low": {
              "reasoningEffort": "low"
            },

            "medium": {
              "reasoningEffort": "medium"
            },

            "high": {
              "reasoningEffort": "high"
            }
          }
        }
      }
    }
  }
}