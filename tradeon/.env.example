# ─────────────────────────────────────────────────────────────
# NexaTrade environment

# 0. PUBLIC SITE URL (SEO) — OPTIONAL.
#    NexaTrade AUTO-DETECTS the live domain from the request (Vercel host
#    headers), so the free *.vercel.app URL works with NOTHING set, and any
#    custom domain you attach later is picked up automatically — no code change
#    and no env change. Set this ONLY if you want to force one canonical
#    domain (e.g. https://nexatrade.app) even when deployed under other hosts.
NEXT_PUBLIC_SITE_URL=

# 0b. SEO / analytics / ads (all optional, public NEXT_PUBLIC_* keys)
#    Google Analytics 4 measurement id (G-XXXXXXXXXX). Empty = GA disabled.
NEXT_PUBLIC_GA_ID=
#    Site-verification codes from Search Console / Bing Webmaster.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
#    Ad/tracking pixels — the numeric Pixel ID. Empty = that pixel is disabled.
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# Copy to .env.local (dev) or paste into Vercel / Render env vars.
# ─────────────────────────────────────────────────────────────

# 1. PERSISTENT DATABASE (required in production)
# Neon:     postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Supabase: postgresql://postgres.xxx:pass@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# If this is empty the app falls back to an embedded PGlite database in ./.data
# (fine for local dev, NOT persistent on serverless hosts — there it lands in the
# OS temp directory, which is wiped on every cold start).
#
# When this URL is wrong or unreachable, login/signup answer 503 with
# { code, hint } and `curl /api/health` explains exactly what is broken.
DATABASE_URL=

# Optional: where the embedded PGlite database lives when DATABASE_URL is empty.
# Defaults to ./.data/pglite, then falls back to the OS temp directory if that
# path is not writable (serverless hosts).
PGLITE_DIR=

# 2. AUTH — any random string, 32+ characters. Generate with:
#    node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# 3. SUPER ADMIN / OWNER (Module 3)
# The protected owner email is arjumankhan181@gmail.com.
# Portal: /nexa-admin-portal/login
# Set SUPER_ADMIN_PASSWORD to your own password (at least 12 characters).
# There is no default password. Missing/short values prevent provisioning
# and disable an existing owner at boot. A changed value rotates the owner's
# password and revokes existing sessions at the next database initialization.
SUPER_ADMIN_PASSWORD=
# Roles: SUPER_ADMIN (owner) · ADMIN · EDITOR · MODERATOR
#
# Optional secondary ADMIN_* staff account (a normal ADMIN, not the owner):
# ADMIN_PASSWORD must also be at least 12 characters. When ADMIN_EMAIL is set,
# the password is synchronized at boot; missing/short values disable that account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# 3b. AUTOMATIC CRYPTO PAYMENTS (Module 5.1 — optional)
# When a gateway key is present the wallet's "Automatic" mode creates a hosted
# invoice and credits balances on the confirmation webhook. Without it, deposits
# flow through the manual finance queue (TrxID + screenshot proof).
#    Get the API key + IPN secret from nowpayments.io → Account → Store
#    Settings / IPN. The IPN callback URL is auto-built from the live domain as
#    https://YOUR-DOMAIN/api/payments/webhook (no code change on custom domain).
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
COINPAYMENTS_API_KEY=
#    Fiat currency deposits are priced in (default usd).
NEXT_PUBLIC_DEPOSIT_CURRENCY=usd

# 4. MARKET DATA
#    Crypto streams straight from Binance public WebSocket (no key required).
#    Forex / commodities use Finnhub or Polygon when a key is present,
#    and a key-free public fallback provider otherwise.
FINNHUB_API_KEY=
POLYGON_API_KEY=

# 5. Optional: secret used by the /api/cron/settle scheduled settlement endpoint
CRON_SECRET=

# ── Optional: shared response cache (Module 1.2). Without these the platform
# uses its per-instance memory cache only — nothing breaks.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
