# ── NexaTrade V2 server (Node.js) ───────────────────────────────────────────
# Real values live only in the server environment / Base44 Secrets.
# Never expose these through VITE_* variables and never commit real values.

PORT=4000
NODE_ENV=development

# Comma-separated allowed browser origins for REST + Socket.io.
CORS_ORIGINS=http://localhost:5173

# Existing PostgreSQL database (Step 2 = READ-ONLY inspection first; a full
# pg_dump backup is taken before any schema-related change).
DATABASE_URL=

# Auth signing secret (32+ random chars) — migrated from the legacy app.
JWT_SECRET=

# Redis cache for live prices (added with the market-data module).
REDIS_URL=
